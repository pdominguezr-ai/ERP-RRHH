{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "ERP RRHH - API Integration Tests",
		"description": "Colección oficial de pruebas de integración HTTP para la API REST del ERP de Recursos Humanos (Universidad Mariano Gálvez - Análisis de Sistemas II). Incluye flujos principales de Autenticación, Gestión de Colaboradores y Solicitudes con aserciones de código de estado y esquemas.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "POST /api/v1/auth/login - Éxito Administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado es HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Retorna token JWT válido', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.token).to.be.a('string');",
									"    pm.environment.set('authToken', jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin.rrhh@empresa.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Autentica un usuario existente en la plataforma y retorna token JWT."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/auth/login - Credenciales Inválidas (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado es HTTP 401 Unauthorized', function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test('Mensaje de error estructurado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.error.code).to.eql('UNAUTHORIZED');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin.rrhh@empresa.com\",\n  \"password\": \"PasswordErroneo\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Gestión de Colaboradores",
			"item": [
				{
					"name": "GET /api/v1/empleados - Listar Colaboradores",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado es HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Estructura paginada correcta', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.pagination).to.have.property('total');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/empleados?estado=ACTIVO&page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"empleados"
							],
							"query": [
								{
									"key": "estado",
									"value": "ACTIVO"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Obtiene la lista de empleados activos paginada."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/empleados - Crear Nuevo Colaborador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado es HTTP 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Código de empleado generado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.codigo).to.match(/^EMP-/);",
									"    pm.environment.set('createdEmpleadoId', jsonData.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombres\": \"Carlos Roberto\",\n  \"apellidos\": \"Gómez Estrada\",\n  \"email\": \"carlos.gomez.test@empresa.com\",\n  \"dpi\": \"2450198270199\",\n  \"departamento\": \"Tecnología\",\n  \"puesto\": \"Desarrollador Senior\",\n  \"salario_base\": 12500.00,\n  \"fecha_contratacion\": \"2026-10-15\",\n  \"estado\": \"ACTIVO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/empleados",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"empleados"
							]
						},
						"description": "Registra un nuevo colaborador en la base de datos."
					},
					"response": []
				},
				{
					"name": "POST /api/v1/empleados - Error Salario Inferior a Mínimo (400)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado es HTTP 400 Bad Request', function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test('Rechazo por regla de negocio de salario mínimo', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.error.code).to.eql('VALIDATION_ERROR');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombres\": \"Ana Maria\",\n  \"apellidos\": \"Lopez\",\n  \"email\": \"ana.lopez@empresa.com\",\n  \"dpi\": \"2450198270188\",\n  \"departamento\": \"Ventas\",\n  \"puesto\": \"Asistente\",\n  \"salario_base\": 2000.00,\n  \"fecha_contratacion\": \"2026-10-15\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/empleados",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"empleados"
							]
						}
					},
					"response": []
				}
			]
		},
