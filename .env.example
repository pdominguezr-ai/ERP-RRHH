# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA ERP DE GESTIÓN DE RECURSOS HUMANOS (ERP-RRHH)
# Arquitectura de Persistencia Políglota (PostgreSQL, MongoDB, Redis, Neo4j)
# ==============================================================================

# 1. PostgreSQL / Supabase (Transaccional Relacional ACID & Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:password@localhost:5432/erp_rrhh

# 2. MongoDB 7.0 (Almacén Documental de Expedientes Digitales y Auditoría)
MONGODB_URI=mongodb://localhost:27017/erp_rrhh_docs

# 3. Redis 7.x (Almacén en Memoria para Patrón Cache-Aside con TTL=300s/600s)
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL_SECONDS=300

# 4. Neo4j 5.x (Base de Datos de Grafos para Organigrama Jerárquico y Competencias)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_erp_password

# 5. Seguridad JWT y Servidor API
JWT_SECRET=erp_rrhh_umg_secret_key_2026
JWT_EXPIRES_IN=3600
PORT=3000
